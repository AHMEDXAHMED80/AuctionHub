/* ===== CSS Variables ===== */
:root {
    /* Vibrant Modern Color Palette */
    --primary: #FF6B35;        /* Vibrant Orange */
    --primary-dark: #E5533D;   /* Dark Orange */
    --primary-light: #FF8A5B;  /* Light Orange */
    --secondary: #004E89;      /* Deep Blue */
    --secondary-light: #1A659E;/* Medium Blue */
    --accent: #F7B801;         /* Golden Yellow */
    --accent-light: #FCCA46;   /* Light Gold */
    --success: #06D6A0;        /* Teal Green */
    --danger: #EF476F;         /* Pink Red */
    --dark: #1B2021;           /* Almost Black */
    --dark-light: #2D3436;     /* Dark Gray */
    --gray-100: #F8F9FA;
    --gray-200: #E9ECEF;
    --gray-300: #DEE2E6;
    --gray-400: #ADB5BD;
    --gray-500: #6C757D;
    --gray-600: #495057;
    --white: #FFFFFF;
    --error: #EF476F;
    --warning: #F7B801;
    
    /* Enhanced Shadows */
    --shadow-sm: 0 2px 4px rgba(0, 0, 0, 0.08);
    --shadow: 0 4px 12px rgba(0, 0, 0, 0.15);
    --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.18);
    --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.25);
    --shadow-xl: 0 24px 64px rgba(0, 0, 0, 0.3);
    
    /* Border Radius */
    --radius-sm: 0.5rem;
    --radius: 0.75rem;
    --radius-lg: 1.25rem;
    --radius-xl: 2rem;
}

/* ===== Reset & Base ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: 'Poppins', sans-serif;
    background: linear-gradient(135deg, #1B2021 0%, #2D3436 50%, #1B2021 100%);
    background-attachment: fixed;
    color: var(--white);
    min-height: 100vh;
    line-height: 1.6;
    position: relative;
}

body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: 
        radial-gradient(circle at 20% 50%, rgba(255, 107, 53, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 80%, rgba(247, 184, 1, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 40% 20%, rgba(0, 78, 137, 0.1) 0%, transparent 50%);
    pointer-events: none;
    z-index: 0;
}

a {
    text-decoration: none;
    color: inherit;
}

/* ===== Buttons ===== */accent) 100%);
    color: var(--white);
    box-shadow: 0 4px 20px rgba(255, 107, 53, 0.4);
    font-weight: 600;
    letter-spacing: 0.3px;
    position: relative;
    overflow: hidden;
}

.btn-primary::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    transition: left 0.5s;
}

.btn-primary:hover::before {
    left: 100%;
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(255, 107, 53, 0.6
    font-weight: 500;
    border-radius: var(--radius);
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: inherit;
}

.btn-primary {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: var(--white);
    box-shadow: 0 4px 15px rgba(99, 102, 241, 0.4);
}

.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.5);
}

.btn-outline {
    background: transparent;
    color: var(--white);
    border: 2px solid rgba(255, 255, 255, 0.3);
}

.btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--white);
}

.btn-white {
    background: var(--white);
    color: var(--primary);
}

.btn-white:hover {
    background: var(--gray-100);
    transform: translateY(-2px);
}

.btn-danger {
    background: rgba(239, 68, 68, 0.15);
    border: 1px solid rgba(239, 68, 68, 0.6);
    color: #fecaca;
}

.btn-danger:hover {
    background: rgba(239, 68, 68, 0.3);
}

.btn-lg {
    padding: 1rem 2rem;
    font-size: 1.1rem;
}

.btn-sm {
    padding: 0.5rem 0.9rem;
    font-size: 0.85rem;
}

.btn-block {
    width: 100%;
}

.btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
}

/* ===== Navigation ===== */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    padding: 1rem 2rem;
    background: rgba(15, 12, 41, 0.8);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.nav-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--white);
}

.logo i {
    color: var(--primary-light);
    font-size: 1.8rem;
}

.hidden {
    display: none !important;
}

.nav-links {
    display: flex;
    gap: 1rem;
    align-items: center;
}

.nav-username {
    color: var(--gray-200);
    font-weight: 600;
    font-size: 0.95rem;
}

/* ===== Hero Section ===== */
.hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8rem 5% 4rem;
    max-width: 1400px;
    margin: 0 auto;
    gap: 4rem;
}

.hero-content {
    flex: 1;
    max-width: 600px;
}

.hero-title {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
}

.gradient-text {
    background: linear-gradient(135deg, var(--primary-light) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.hero-subtitle {
    font-size: 1.2rem;
    color: var(--gray-300);
    margin-bottom: 2rem;
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 1rem;
    margin-bottom: 3rem;
    flex-wrap: wrap;
}

.hero-stats {
    display: flex;
    gap: 3rem;
}

.stat {
    display: flex;
    flex-direction: column;
}

.stat-number {
    font-size: 2rem;
    font-weight: 700;
    color: var(--primary-light);
}

.stat-label {
    font-size: 0.9rem;
    color: var(--gray-400);
}

.hero-image {
    flex: 1;
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 400px;
}

.auction-illustration {
    width: 250px;
    height: 250px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 60px rgba(99, 102, 241, 0.5);
    animation: pulse 2s ease-in-out infinite;
}

.auction-illustration i {
    font-size: 6rem;
    color: var(--white);
}

@keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.floating-card {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    padding: 1rem 1.5rem;
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    animation: float 3s ease-in-out infinite;
}

.floating-card i {
    font-size: 1.5rem;
    color: var(--primary-light);
}

.card-1 {
    top: 10%;
    left: 0;
    animation-delay: 0s;
}

.card-2 {
    top: 50%;
    right: 0;
    animation-delay: 0.5s;
}

.card-3 {
    bottom: 10%;
    left: 10%;
    animation-delay: 1s;
}

@keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
}

/* ===== Features Section ===== */
.features {
    padding: 6rem 5%;
    background: rgba(0, 0, 0, 0.2);
}

.section-title {
    text-align: center;
    font-size: 2.5rem;
    margin-bottom: 3rem;
}

.features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    max-width: 1200px;
    margin: 0 auto;
}

.feature-card {
    background: rgba(255, 255, 255, 0.05);
    padding: 2rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.3s ease;
}

.feature-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.1);
    border-color: var(--primary-light);
}

.feature-icon {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    border-radius: var(--radius);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
}

.feature-icon i {
    font-size: 1.5rem;
    color: var(--white);
}

.feature-card h3 {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
}

.feature-card p {
    color: var(--gray-400);
    font-size: 0.95rem;
}

/* ===== CTA Section ===== */
.cta {
    padding: 6rem 5%;
    text-align: center;
}

.cta-content {
    max-width: 600px;
    margin: 0 auto;
}

.cta h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}

.cta p {
    color: var(--gray-300);
    font-size: 1.1rem;
    margin-bottom: 2rem;
}

/* ===== Footer ===== */
.footer {
    background: rgba(0, 0, 0, 0.3);
    padding: 4rem 5% 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4rem;
    max-width: 1200px;
    margin: 0 auto 3rem;
}

.footer-brand p {
    color: var(--gray-400);
    margin-top: 1rem;
}

.footer-links h4 {
    margin-bottom: 1rem;
    color: var(--white);
}

.footer-links a {
    display: block;
    color: var(--gray-400);
    margin-bottom: 0.5rem;
    transition: color 0.3s ease;
}

.footer-links a:hover {
    color: var(--primary-light);
}

.footer-bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    color: var(--gray-500);
}

/* ===== Auth Pages ===== */
.auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6rem 1rem 2rem;
}

.auth-container {
    width: 100%;
    max-width: 480px;
}

.auth-card {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border-radius: var(--radius-xl);
    padding: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-lg);
}

.auth-header {
    text-align: center;
    margin-bottom: 2rem;
}

.auth-header h1 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
}

.auth-header p {
    color: var(--gray-400);
}

.auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.form-row-3 {
    grid-template-columns: repeat(3, 1fr);
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.form-group label {
    font-size: 0.9rem;
    color: var(--gray-300);
    font-weight: 500;
}

.form-group input,
.form-group select,
.form-group textarea {
    padding: 0.875rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    color: var(--white);
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.3s ease;
}

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: var(--gray-500);
}

.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
    outline: none;
    border-color: var(--primary-light);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.form-group select option {
    background: var(--dark);
    color: var(--white);
}

.form-group textarea {
    min-height: 120px;
    resize: vertical;
}

.form-group.error input {
    border-color: var(--error);
}

.error-message {
    color: var(--error);
    font-size: 0.8rem;
    display: none;
}

.form-group.error .error-message {
    display: block;
}

/* Field feedback for availability checks */
.field-feedback {
    display: block;
    font-size: 0.8rem;
    margin-top: 0.25rem;
    min-height: 1.2rem;
}

.field-feedback.success {
    color: var(--success);
}

.field-feedback.error {
    color: var(--error);
}

.field-status {
    display: block;
    min-height: 1.2rem;
    font-size: 0.85rem;
    color: var(--gray-400);
    margin-top: -0.1rem;
}

.field-status.status-info,
.field-status.status-loading {
    color: var(--gray-400);
}

.field-status.status-available {
    color: var(--success);
}

.field-status.status-unavailable {
    color: var(--error);
}

.password-input {
    position: relative;
}

.password-input input {
    padding-right: 3rem;
}

.password-toggle {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: var(--gray-400);
    cursor: pointer;
    transition: color 0.3s ease;
}

.password-toggle:hover {
    color: var(--white);
}

.form-footer {
    text-align: center;
    margin-top: 1.5rem;
    color: var(--gray-400);
}

.form-footer a {
    color: var(--primary-light);
    font-weight: 500;
    transition: color 0.3s ease;
}

.form-footer a:hover {
    color: var(--white);
}

/* Alert Messages */
.alert {
    padding: 1rem;
    border-radius: var(--radius);
    margin-bottom: 1.5rem;
    display: none;
}

.alert.show {
    display: block;
}

.alert-error {
    background: rgba(239, 68, 68, 0.2);
    border: 1px solid var(--error);
    color: #fca5a5;
}

.alert-success {
    background: rgba(34, 197, 94, 0.2);
    border: 1px solid var(--success);
    color: #86efac;
}

/* Loading Spinner */
.spinner {
    width: 20px;
    height: 20px;
    border: 2px solid transparent;
    border-top-color: currentColor;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
}

@keyframes spin {
    to { transform: rotate(360deg); }
}

/* ===== Items Page ===== */
.items-page {
    padding: 7rem 5% 3rem;
    max-width: 1400px;
    margin: 0 auto;
}

.items-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
}

.items-header-actions {
    display: flex;
    gap: 0.75rem;
    align-items: center;
}

.items-title h1 {
    font-size: 2.6rem;
    margin-bottom: 0.5rem;
}

.items-title p {
    color: var(--gray-400);
    max-width: 520px;
}

.items-layout {
    display: grid;
    grid-template-columns: minmax(320px, 420px) 1fr;
    gap: 2rem;
    align-items: start;
}

.items-panel {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(20px);
    border-radius: var(--radius-lg);
    padding: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: var(--shadow-md);
}

.items-panel-header {
    margin-bottom: 1.5rem;
}

.items-panel-header h2 {
    font-size: 1.5rem;
    margin-bottom: 0.35rem;
}

.items-panel-header p {
    color: var(--gray-400);
}

.items-panel-header-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
}

.items-note {
    background: rgba(129, 140, 248, 0.12);
    border: 1px solid rgba(129, 140, 248, 0.3);
    color: var(--gray-200);
    padding: 0.75rem 1rem;
    border-radius: var(--radius);
    margin-bottom: 1rem;
    font-size: 0.9rem;
}

.items-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

.images-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.images-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.images-header h3 {
    font-size: 1.1rem;
}

.images-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.image-row {
    display: grid;
    grid-template-columns: 70px 1fr auto;
    gap: 0.75rem;
    align-items: center;
}

.image-row-index {
    text-align: center;
    padding: 0.65rem 0.5rem;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--gray-200);
    font-weight: 600;
}

.image-row input {
    padding: 0.75rem 1rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius);
    color: var(--white);
    font-size: 0.95rem;
    font-family: inherit;
    transition: all 0.3s ease;
}

.image-row input:focus {
    outline: none;
    border-color: var(--primary-light);
    background: rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
}

.helper-text {
    color: var(--gray-400);
    font-size: 0.85rem;
}

.existing-images-panel {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.existing-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.75rem;
}

.existing-image {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    min-height: 90px;
}

.existing-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.existing-image span {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background: rgba(15, 12, 41, 0.75);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
}

.items-summary {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.summary-card {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius);
    padding: 0.5rem 0.75rem;
    min-width: 80px;
    text-align: center;
}

.summary-label {
    display: block;
    font-size: 0.75rem;
    color: var(--gray-400);
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.summary-value {
    font-size: 1.2rem;
    font-weight: 600;
}

.items-grid {
    display: grid;
    gap: 1.5rem;
}

.items-empty,
.items-loading {
    padding: 2.5rem;
    text-align: center;
    color: var(--gray-400);
    border: 1px dashed rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-lg);
}

.item-card {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.item-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
}

.item-card-title h3 {
    font-size: 1.3rem;
    margin-bottom: 0.3rem;
}

.item-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid transparent;
}

.status-active {
    background: rgba(34, 197, 94, 0.2);
    color: #86efac;
    border-color: rgba(34, 197, 94, 0.35);
}

.status-inactive {
    background: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
    border-color: rgba(239, 68, 68, 0.35);
}

.status-unknown {
    background: rgba(99, 102, 241, 0.2);
    color: #c7d2fe;
    border-color: rgba(99, 102, 241, 0.35);
}

.item-description {
    color: var(--gray-300);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.item-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
    color: var(--gray-300);
    font-size: 0.85rem;
}

.item-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
}

.item-meta i {
    color: var(--primary-light);
}

.item-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 0.75rem;
}

.item-image {
    position: relative;
    border-radius: var(--radius);
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    min-height: 90px;
}

.item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
}

.item-image span {
    position: absolute;
    bottom: 6px;
    right: 6px;
    background: rgba(15, 12, 41, 0.75);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
}

.item-image-placeholder {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--gray-400);
    font-size: 0.85rem;
    padding: 1rem;
    text-align: center;
}

.item-tools {
    display: grid;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.swap-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
}

.swap-controls input {
    max-width: 90px;
}

.item-advanced {
    background: rgba(255, 255, 255, 0.03);
    border-radius: var(--radius);
    padding: 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
}

.item-advanced summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--gray-200);
}

.advanced-grid {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.75rem;
}

.form-actions {
    display: grid;
    gap: 0.75rem;
}

/* ===== Responsive ===== */
@media (max-width: 1024px) {
    .hero {
        flex-direction: column;
        text-align: center;
        padding-top: 6rem;
    }
    
    .hero-content {
        max-width: 100%;
    }
    
    .hero-buttons {
        justify-content: center;
    }
    
    .hero-stats {
        justify-content: center;
    }
    
    .hero-image {
        min-height: 300px;
    }
    
    .footer-content {
        grid-template-columns: 1fr;
        text-align: center;
        gap: 2rem;
    }

    .items-header {
        flex-direction: column;
        align-items: flex-start;
    }

    .items-layout {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 768px) {
    .hero-title {
        font-size: 2.5rem;
    }
    
    .hero-stats {
        flex-direction: column;
        gap: 1.5rem;
    }
    
    .floating-card {
        display: none;
    }
    
    .auth-card {
        padding: 2rem;
    }
    
    .form-row {
        grid-template-columns: 1fr;
    }

    .form-row-3 {
        grid-template-columns: 1fr;
    }

    .items-panel-header-row {
        flex-direction: column;
        align-items: flex-start;
    }

    .item-meta {
        grid-template-columns: 1fr;
    }

    .image-row {
        grid-template-columns: 1fr;
    }

    .image-row-index {
        text-align: left;
    }
}

@media (max-width: 480px) {
    .hero-title {
        font-size: 2rem;
    }
    
    .hero-buttons {
        flex-direction: column;
    }
    
    .btn-lg {
        padding: 0.875rem 1.5rem;
        font-size: 1rem;
    }
    
    .nav-links .btn {
        padding: 0.5rem 1rem;
        font-size: 0.85rem;
    }
}
